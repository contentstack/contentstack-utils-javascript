{
  "name": "@contentstack/utils",
  "version": "1.9.2",
  "description": "Contentstack utilities for Javascript",
  "main": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "Contentstack",
    "contentstack",
    "contentstack javascript",
    "Contentstack javascript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/contentstack/contentstack-utils-javascript.git"
  },
  "scripts": {
    "clear:reports": "rm -rf reports",
    "clear:badges": "rm -rf badges",
    "pretest": "npm run build",
    "test": "npm run clear:reports && jest --ci --json --coverage --testLocationInResults --outputFile=./reports/report.json",
    "test:badges": "npm run clear:badges && npm run test && jest-coverage-badges --input ./reports/coverage/coverage-summary.json --output ./badges",
    "test:debug": "jest --watchAll --runInBand",
    "prebuild": "rimraf dist && mkdir -p dist/lib && npm run download-regions",
    "download-regions": "mkdir -p src/assets && curl -s --max-time 30 --fail https://artifacts.contentstack.com/regions.json -o src/assets/regions.json || echo 'Warning: Failed to download regions.json'",
    "build": "tsc && rollup -c",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install && npm run build",
    "prepublishOnly": "npm test"
  },
  "author": "Contentstack",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@types/jest": "^26.0.24",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "commitizen": "^4.3.2",
    "eslint": "^9.39.5",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-coverage-badges": "^1.1.2",
    "jest-environment-jsdom": "^29.7.0",
    "jest-html-reporters": "^2.1.7",
    "jest-junit": "^15.0.0",
    "jsdom": "^25.0.1",
    "jsdom-global": "^3.0.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "rollup": "^4.67.4",
    "rollup-plugin-typescript2": "^0.37.0",
    "snyk": "^1.1308.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}